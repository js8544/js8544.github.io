---
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
<title type="text">{{ site.title | xml_escape }}</title>
<link rel="self" type="application/atom+xml" href="{{ site.url }}/feed.xml" />
<link rel="alternate" type="text/html" href="{{ site.url }}/" />
<updated>{{ site.time | date_to_xmlschema }}</updated>
<id>{{ site.url }}/</id>
<author>
  <name>{{ site.owner.name }}</name>
  <uri>{{ site.url }}/</uri>
</author>
{% assign feed_posts = site.posts | where_exp: 'p', 'p.hidden != true' %}
{% for post in feed_posts limit:20 %}
<entry>
  <title type="html"><![CDATA[{{ post.title | cdata_escape }}]]></title>
  <link rel="alternate" type="text/html" href="{{ site.url }}{{ post.url }}" />
  <id>{{ site.url }}{{ post.id }}</id>
  <published>{{ post.date | date_to_xmlschema }}</published>
  <updated>{{ post.date | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.owner.name }}</name>
    <uri>{{ site.url }}/</uri>
  </author>
  <content type="html">{{ post.content | split: '<!--translation-->' | first | xml_escape }}</content>
</entry>
{% endfor %}
</feed>
